{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"vulnerabilityAlerts": { "groupName": null },
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)\\.github/workflows/.+\\.ya?ml$/"],
			"matchStrings": [
				"uses:\\s+&(?<anchor>[A-Za-z0-9_-]+)\\s+(?<depName>[^\\s@]+/[^\\s@]+)@(?<currentDigest>[a-f0-9]{40}|[a-f0-9]{64})\\s*#\\s*(?<currentValue>[^\\s#]+)"
			],
			"datasourceTemplate": "github-tags",
			"versioningTemplate": "github-actions",
			"depTypeTemplate": "action"
		}
	],
	"packageRules": [
		{
			"description": "ignore malformed GitHub Action names produced from YAML anchors",
			"matchManagers": ["github-actions"],
			"matchDepNames": ["/^&[A-Za-z0-9_-]+\\s+[^\\s]+\\/[^\\s]+$/"],
			"enabled": false
		},
		{
			"description": "gix crates release in lockstep",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["/^gix(-.+)?$/"],
			"groupName": "gix crates"
		},
		{
			"description": "tree-sitter crates and bindings",
			"matchPackageNames": ["/^tree-sitter/", "/jtreesitter/"],
			"groupName": "tree-sitter"
		},
		{
			"description": "remaining non-major Rust updates",
			"matchManagers": ["cargo"],
			"matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
			"groupName": "rust dependencies"
		},
		{
			"description": "non-major GitHub Actions updates",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "github actions"
		},
		{
			"description": "non-major anchored GitHub Actions updates",
			"matchManagers": ["custom.regex"],
			"matchDepTypes": ["action"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "github actions"
		},
		{
			"description": "non-major Maven updates",
			"matchManagers": ["maven"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "maven dependencies"
		},
		{
			"description": "non-major npm and Bun updates",
			"matchManagers": ["npm", "bun"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "js dependencies"
		},
		{ "description": "Docker image updates", "matchManagers": ["dockerfile", "docker-compose"], "groupName": "docker images" }
	]
}
