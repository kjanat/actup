{
	"$schema": "https://opencode.ai/config.json",
	"model": "anthropic/claude-opus-4-6",
	"small_model": "anthropic/claude-sonnet-4-6",
	"experimental": { "batch_tool": true },
	"username": "{env:USER}",
	"formatter": {
		"dprint": {
			"command": ["dprint", "fmt", "$FILE"],
			"extensions": [".sh", ".bash", ".toml", ".svg", ".json", ".rs", ".md", ".ts", ".mts", ".cts", ".js", ".mjs", ".cjs", ".yml", ".yaml"],
		},
	},
	"lsp": {
		"actup": {
			"command": ["cargo", "run", "--bin=actup-lsp", "--manifest-path=crates/lsp/Cargo.toml"],
			"extensions": [".yaml", ".yml"],
			"disabled": false,
		},
	},
}
