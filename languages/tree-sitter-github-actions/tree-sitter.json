{
	"$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
	"grammars": [
		{
			"path": ".",
			"name": "github_actions",
			"camelcase": "GithubActions",
			"title": "Github Actions",
			"scope": "source.github_actions",
			"file-types": ["yaml", "yml"],
			"highlights": ["queries/highlights.scm"],
			"injections": ["queries/injections.scm"]
		}
	],
	"metadata": {
		"version": "0.1.0",
		"license": "MIT",
		"description": "Github Actions grammar for tree-sitter",
		"authors": [{ "name": "Kaj Kowalski", "email": "info@kajkowalski.nl", "url": "https://github.com/kjanat" }],
		"links": { "repository": "https://github.com/kjanat/actup-v2", "funding": "https://github.com/kjanat/funding" }
	},
	"bindings": { "c": true, "go": true, "java": true, "node": true, "python": true, "rust": true, "swift": true, "zig": true }
}
