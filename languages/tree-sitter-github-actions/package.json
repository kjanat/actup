{
	"name": "tree-sitter-github-actions",
	"version": "0.1.0",
	"description": "Github Actions grammar for tree-sitter",
	"keywords": ["incremental", "parsing", "tree-sitter", "github_actions"],
	"repository": { "type": "git", "url": "git+https://github.com/kjanat/actup.git", "directory": "languages/tree-sitter-github-actions" },
	"funding": "https://github.com/kjanat/funding",
	"license": "MIT",
	"author": { "name": "Kaj Kowalski", "email": "info@kajkowalski.nl", "url": "https://github.com/kjanat" },
	"type": "module",
	"exports": { "./package.json": "./package.json", "./tree-sitter-github-actions.wasm": "./tree-sitter-github-actions.wasm" },
	"main": "bindings/node",
	"types": "bindings/node",
	"files": [
		"grammar.js",
		"tree-sitter.json",
		"binding.gyp",
		"prebuilds/**",
		"bindings/node/*",
		"queries/*",
		"scripts/**",
		"src/**",
		"*.wasm"
	],
	"scripts": {
		"check": "biome check",
		"fmt": "dprint fmt",
		"generate": "tree-sitter generate && dprint fmt",
		"highlight": "tree-sitter highlight ../../.github/*/*.y*ml",
		"preinstall": "node scripts/ensure-generated.mjs",
		"install": "node-gyp-build",
		"lint": "biome lint",
		"prestart": "tree-sitter build --wasm",
		"start": "tree-sitter playground",
		"test": "node --test bindings/node/*_test.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": { "node-addon-api": "^8.5.0", "node-gyp-build": "^4.8.4" },
	"devDependencies": { "prebuildify": "^6.0.1", "tree-sitter": "^0.25.0", "tree-sitter-cli": "^0.26.8" },
	"peerDependencies": { "tree-sitter": "^0.25.0" },
	"peerDependenciesMeta": { "tree-sitter": { "optional": true } },
	"packageManager": "bun@1.3.13",
	"volta": { "node": "26.0.0", "npm": "11.13.0" }
}
