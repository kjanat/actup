// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
	"formatter": [{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } }],
	"prettier": { "allowed": false },
	"wrap_guides": [140],
	"languages": {
		"TypeScript": { "language_servers": ["vtsls", "tsgo", "biome", "!eslint"] },
		"Rust": { "wrap_guides": [100] },
		"GitHub Actions": {
			"language_servers": ["actup-lsp", "actions-language-server", "..."] // "yaml-language-server",
		}
	},
	"file_types": {
		// "GitHub Actions"
		"YAML": [".github/workflows/*.yml", ".github/workflows/*.yaml", ".github/actions/*.yml", ".github/actions/*.yaml"]
	},
	"lsp": { "actup-lsp": { "binary": { "path": "cargo", "arguments": ["actup-lsp"] } } }
}
