// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
	"formatter": [{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } }],
	"prettier": { "allowed": false },
	"wrap_guides": [140],
	"languages": {
		"TypeScript": { "language_servers": ["vtsls", "tsgo", "biome", "!eslint"] },
		"Rust": { "wrap_guides": [100] },
		"GitHub Actions": {
			// "yaml-language-server",
			"language_servers": ["actup-lsp", "..."]
		}
	},
	"file_types": { "GitHub Actions": ["**/.github/workflows/*.yml", "**/.github/workflows/*.yaml"] },
	"lsp": {
		"rust-analyzer": {
			"initialization_options": {
				"diagnostics": { "experimental": { "enable": true } },
				"cargo": { "allFeatures": true, "allTargets": true },
				"check": { "workspace": true },
				"completion": { "snippets": { "custom": {} } }
			}
		},
		"actup-lsp": {
			// or set "binary": { "path": "target/debug/actup-lsp" }
			"binary": { "path": "cargo", "arguments": ["run", "--bin=actup-lsp", "--manifest-path=crates/lsp/Cargo.toml"] }
		}
	}
}
