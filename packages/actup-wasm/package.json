{
	"name": "actup-wasm",
	"version": "0.1.0",
	"description": "Parse and check GitHub Actions uses: refs — powered by actup-core compiled to WASM",
	"keywords": ["github-actions", "wasm", "yaml", "linter", "checker", "updater"],
	"homepage": "https://github.com/kjanat/actup-v2#readme",
	"bugs": { "url": "https://github.com/kjanat/actup-v2/issues" },
	"repository": { "type": "git", "url": "https://github.com/kjanat/actup-v2", "directory": "packages/actup-wasm" },
	"license": "MIT OR Apache-2.0",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
		"./provider": { "types": "./dist/provider.d.ts", "default": "./dist/provider.js" },
		"./wasm": "./wasm/actup_wasm_bg.wasm",
		"./*": "./*"
	},
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist/", "wasm/", "src/", "LICENSE-MIT", "LICENSE-APACHE"],
	"scripts": {
		"bd": "bun run build",
		"build": "bun build:wasm && bun build:ts",
		"build:ts": "tsc",
		"build:wasm": "bun scripts/build-wasm.ts",
		"clean": "rm -rf dist/ wasm/",
		"prepack": "cp ../../LICENSE* .",
		"postpack": "rm -f LICENSE*",
		"prepublishOnly": "bun bd && bun run test",
		"test": "node --test tests/node_import.mjs tests/provider.mjs",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": { "@types/node": "catalog:", "typescript": "catalog:" },
	"engines": { "node": ">=18" }
}
