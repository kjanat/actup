{
	"name": "actup",
	"version": "0.0.0+dev",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": ["extensions/*", "languages/*", "languages/*/schema/*", "packages/*"],
		"catalog": {
			"@eslint/js": "^10.0.1",
			"@stylistic/eslint-plugin": "^5.10.0",
			"@types/node": "^24.0.0",
			"@vscode/vsce": "^3.9.1",
			"eslint": "^10.2.1",
			"tsdown": "^0.21.10",
			"typescript": "^6.0.3",
			"typescript-eslint": "^8.59.0",
			"vscode-languageclient": "^9.0.1"
		}
	},
	"scripts": {
		"bd": "bun run --filter '*' bd",
		"build": "bun run --filter '*' build",
		"postbuild": "bun run --filter '*' postbuild",
		"build:ts": "bun run --filter '*' build:ts",
		"build:wasm": "bun run --filter 'actup-wasm' build:wasm"
	},
	"devDependencies": { "@kjanat/dreamcli": "latest", "@types/bun": "latest", "sort-package-json": "latest", "tombi": "latest" },
	"peerDependencies": { "jsonc-parser": "^3.3.1" },
	"packageManager": "bun@1.3.13",
	"patchedDependencies": { "tree-sitter@0.25.0": "patches/tree-sitter@0.25.0.patch" }
}
